# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# TMDB API key (required for posters, trailers, cast, reviews and live movie data)
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Google Gemini API key (optional, powers the AI Assistant tab)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API key (optional, used as an alternate chat backend if set)
OPENAI_API_KEY=

# SMTP settings (optional, used to email booking confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=true
